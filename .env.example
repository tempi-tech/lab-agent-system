# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel IDs
# レポートを投稿するチャンネルID
DISCORD_CHANNEL_ID=123456789012345678
# --once 実行時の投稿先（任意・未設定なら GitHub Actions 以外ではテストチャンネルにデフォルト）
# DISCORD_RUN_ONCE_CHANNEL_ID=123456789012345678
# DailyReporter を起動するか（0/false/no で無効化）
ENABLE_DAILY_REPORTER=1

# Discord Access Policy (global)
# 無効化したい場合は false/no/0
DISCORD_ACCESS_ENABLED=true
# 空欄なら全チャンネル対象（botがアクセス可能なチャンネル）
DISCORD_ALLOWED_CHANNEL_IDS=
# true の場合はメンション必須
DISCORD_REQUIRE_MENTION=false

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
# または Vertex AI を使う場合
# GOOGLE_CLOUD_PROJECT=your_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# Source Channels (Comma-separated IDs of channels to monitor)
SOURCE_CHANNEL_IDS=

# OpenRouter API (for LLM Council agent)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_EXCLUDE_REASONING=true
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 任意（OpenRouterの推奨ヘッダー）
# OPENROUTER_APP_URL=https://example.com
# OPENROUTER_APP_NAME=lab-agent-system

# Quiz Master Agent
QUIZ_ADMIN_USER_IDS=YOUR_DISCORD_USER_ID
QUIZ_ADMIN_CHANNEL_ID=123456789012345678
QUIZ_FORUM_CHANNEL_ID=123456789012345678
QUIZ_LLM_PROVIDER=gemini
QUIZ_GEMINI_MODEL=gemini-3-flash-preview
QUIZ_CLAUDE_MODEL=claude-sonnet-4-5
QUIZ_DEFAULT_CONFIG=src/agents/quiz_master/quizzes/bonenkai_2025.json
# QUIZ_WEBHOOK_NAME=QuizMaster Webhook
# QUIZ_BOT_AVATAR_PATH=src/agents/quiz_master/Airi.jpg
# QUIZ_ADMIN_ROLE_IDS=ROLE_ID_1,ROLE_ID_2
# QUIZ_DEBUG=1

# Claude API
ANTHROPIC_API_KEY=your_claude_api_key_here

# Lab Onboarder (プロフィールカード)
LAB_ONBOARDER_GUILD_ID=123456789012345678
PROFILE_FORUM_CHANNEL_ID=123456789012345678
# LLMモデル（紹介文生成に使用）
# LAB_ONBOARDER_LLM_MODEL=gemini-3-flash-preview
# agi-lab と agi-lab-admin のロールIDをカンマ区切りで指定
LAB_ONBOARDER_ALLOWED_ROLE_IDS=ROLE_ID_1,ROLE_ID_2
# 管理者（デバッグコマンド）用ロールID
LAB_ONBOARDER_ADMIN_ROLE_IDS=ROLE_ID_ADMIN
# LAB_ONBOARDER_SQLITE_PATH=data/lab_onboarder/profiles.sqlite
# LAB_ONBOARDER_LOG_PATH=data/lab_onboarder/lab_onboarder.log
# LAB_ONBOARDER_LOG_CHANNEL_ID=123456789012345678
# テスト中だけDM送信を特定ユーザーに限定したい場合（空なら誰にも送らない）
# LAB_ONBOARDER_DM_ALLOWLIST_USER_IDS=YOUR_DISCORD_USER_ID
# またはユーザー名で限定
# LAB_ONBOARDER_DM_ALLOWLIST_USERNAMES=your_username
# デバッグログ
# LAB_ONBOARDER_DEBUG=1

# Membership Checker (note会員とDiscordの同期)
# レポート投稿先チャンネルID（必須）
MEMBERSHIP_CHECKER_LOG_CHANNEL_ID=123456789012345678
# note会員CSVのディレクトリ（任意・デフォルト: ~/Develop/note-extract-auto/data/output/active）
# MEMBERSHIP_CHECKER_CSV_DIR=/path/to/csv/dir
# レポート出力先ディレクトリ（任意・デフォルト: data/membership_checker）
# MEMBERSHIP_CHECKER_DATA_DIR=data/membership_checker
# ユーザー名マッチングを有効化（デフォルト: false）
# MEMBERSHIP_CHECKER_CONFIRM_USERNAMES=false
# デバッグログ
# MEMBERSHIP_CHECKER_DEBUG=1

# Updates Assistant (サーバー内アップデートQ&A + 雑談)
UPDATES_ASSISTANT_ENABLED=true
# 空欄なら全チャンネル対象（botがアクセス可能なチャンネル）
UPDATES_ASSISTANT_ALLOWED_CHANNEL_IDS=
# 0 でレートリミット無効化
UPDATES_ASSISTANT_RATE_LIMIT_SECONDS=0
UPDATES_ASSISTANT_DEFAULT_PERIOD=24h
UPDATES_ASSISTANT_LLM_PROVIDER=openrouter
UPDATES_ASSISTANT_LLM_MODEL=deepseek/deepseek-v3.2
UPDATES_ASSISTANT_REACTION_EMOJI=👀
UPDATES_ASSISTANT_CHAT_ONLY=false
UPDATES_ASSISTANT_REPLY_AS_MENTION=true
UPDATES_ASSISTANT_CONTEXT_MAX_MESSAGES=15
UPDATES_ASSISTANT_CONTEXT_INCLUDE_BOTS=false
# LLM Router (mention routing)
UPDATES_ASSISTANT_ROUTER_ENABLED=true
UPDATES_ASSISTANT_ROUTER_LLM_PROVIDER=openrouter
UPDATES_ASSISTANT_ROUTER_LLM_MODEL=deepseek/deepseek-v3.2
UPDATES_ASSISTANT_ROUTER_LLM_TEMPERATURE=0.0
UPDATES_ASSISTANT_ROUTER_LLM_MAX_OUTPUT_TOKENS=256
UPDATES_ASSISTANT_ROUTER_DEFAULT_SCOPE=channel
# デバッグログを送信するチャンネルID（空欄ならコンソールのみ）
UPDATES_ASSISTANT_LOG_CHANNEL_ID=
UPDATES_ASSISTANT_DEBUG=false

# Claude Search (Discord検索 + OpenRouter LLM)
CLAUDE_SEARCH_ENABLED=true
CLAUDE_SEARCH_MAX_RESULTS=8
CLAUDE_SEARCH_DISCORD_SEARCH_LIMIT=20
CLAUDE_SEARCH_RATE_LIMIT_SECONDS=15
CLAUDE_SEARCH_LLM_PROVIDER=openrouter
CLAUDE_SEARCH_LLM_MODEL=deepseek/deepseek-chat
CLAUDE_SEARCH_LLM_TEMPERATURE=0.2
CLAUDE_SEARCH_LLM_MAX_OUTPUT_TOKENS=800
# デバッグログを送信するチャンネルID（空欄ならコンソールのみ）
CLAUDE_SEARCH_LOG_CHANNEL_ID=
CLAUDE_SEARCH_DEBUG=false

# Question SLA (未回答質問の検知・エスカレーション)
# 有効化（default: false）
QUESTION_SLA_ENABLED=false
# 監視対象フォーラムチャンネルID（カンマ区切り・必須扱い）
QUESTION_SLA_FORUM_CHANNEL_IDS=
# エスカレーション通知先チャンネルID（運営向け）
QUESTION_SLA_ESCALATION_CHANNEL_ID=
# 最初のリマインドまでの分数（default: 120）
QUESTION_SLA_FIRST_REMINDER_MINUTES=120
# エスカレーションまでの分数（default: 1440）
QUESTION_SLA_ESCALATE_MINUTES=1440
# 定期チェック間隔（秒, default: 60）
QUESTION_SLA_TICK_SECONDS=60
# SQLiteの保存先（任意）
# QUESTION_SLA_SQLITE_PATH=data/question_sla/state.sqlite
# デバッグログ
QUESTION_SLA_DEBUG=false

# Community Analytics (週間分析ダッシュボード)
# 有効化（default: false）
COMMUNITY_ANALYTICS_ENABLED=false
# 週間レポート投稿先チャンネルID（run-once analytics 用）
COMMUNITY_ANALYTICS_CHANNEL_ID=
# 常時更新のダッシュボード（同一メッセージを編集して更新）
# 有効化（default: false）
COMMUNITY_ANALYTICS_DASHBOARD_ENABLED=false
# 更新間隔（秒, default: 3600）
COMMUNITY_ANALYTICS_DASHBOARD_UPDATE_SECONDS=3600
# 既存メッセージIDを指定する場合（指定時はそのメッセージのみ編集）
COMMUNITY_ANALYTICS_DASHBOARD_MESSAGE_ID=
# ダッシュボードメッセージをピン留めする（権限が必要, default: false）
COMMUNITY_ANALYTICS_DASHBOARD_PIN=false
# ダッシュボード状態（message_id等）保存先（任意）
# COMMUNITY_ANALYTICS_DASHBOARD_STATE_PATH=data/community_analytics/dashboard_state.json
# 対象期間（日数, default: 7）
COMMUNITY_ANALYTICS_DAYS=7
# JSON保存先ディレクトリ（任意）
# COMMUNITY_ANALYTICS_DATA_DIR=data/community_analytics
# デバッグログ
COMMUNITY_ANALYTICS_DEBUG=false
