# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel IDs
# レポートを投稿するチャンネルID
DISCORD_CHANNEL_ID=123456789012345678
# DailyReporter を起動するか（0/false/no で無効化）
ENABLE_DAILY_REPORTER=1

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
# または Vertex AI を使う場合
# GOOGLE_CLOUD_PROJECT=your_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# Source Channels (Comma-separated IDs of channels to monitor)
SOURCE_CHANNEL_IDS=

# OpenRouter API (for LLM Council agent)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Quiz Master Agent
QUIZ_ADMIN_USER_IDS=YOUR_DISCORD_USER_ID
QUIZ_ADMIN_CHANNEL_ID=123456789012345678
QUIZ_FORUM_CHANNEL_ID=1451437929754001448
QUIZ_LLM_PROVIDER=gemini
QUIZ_GEMINI_MODEL=gemini-3-flash-preview
QUIZ_CLAUDE_MODEL=claude-sonnet-4-5
QUIZ_DEFAULT_CONFIG=src/agents/quiz_master/quizzes/bonenkai_2025.json
# QUIZ_WEBHOOK_NAME=QuizMaster Webhook
# QUIZ_BOT_AVATAR_PATH=src/agents/quiz_master/Airi.jpg
# QUIZ_ADMIN_ROLE_IDS=ROLE_ID_1,ROLE_ID_2
# QUIZ_DEBUG=1

# Claude API
ANTHROPIC_API_KEY=your_claude_api_key_here
