# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel IDs
# レポートを投稿するチャンネルID
DISCORD_CHANNEL_ID=123456789012345678
# --once 実行時の投稿先（任意・未設定なら GitHub Actions 以外ではテストチャンネルにデフォルト）
# DISCORD_RUN_ONCE_CHANNEL_ID=123456789012345678
# DailyReporter を起動するか（0/false/no で無効化）
ENABLE_DAILY_REPORTER=1

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
# または Vertex AI を使う場合
# GOOGLE_CLOUD_PROJECT=your_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# Source Channels (Comma-separated IDs of channels to monitor)
SOURCE_CHANNEL_IDS=

# OpenRouter API (for LLM Council agent)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Quiz Master Agent
QUIZ_ADMIN_USER_IDS=YOUR_DISCORD_USER_ID
QUIZ_ADMIN_CHANNEL_ID=123456789012345678
QUIZ_FORUM_CHANNEL_ID=123456789012345678
QUIZ_LLM_PROVIDER=gemini
QUIZ_GEMINI_MODEL=gemini-3-flash-preview
QUIZ_CLAUDE_MODEL=claude-sonnet-4-5
QUIZ_DEFAULT_CONFIG=src/agents/quiz_master/quizzes/bonenkai_2025.json
# QUIZ_WEBHOOK_NAME=QuizMaster Webhook
# QUIZ_BOT_AVATAR_PATH=src/agents/quiz_master/Airi.jpg
# QUIZ_ADMIN_ROLE_IDS=ROLE_ID_1,ROLE_ID_2
# QUIZ_DEBUG=1

# Claude API
ANTHROPIC_API_KEY=your_claude_api_key_here

# Lab Onboarder (プロフィールカード + マッチング)
LAB_ONBOARDER_GUILD_ID=123456789012345678
PROFILE_FORUM_CHANNEL_ID=123456789012345678
EXA_API_KEY=your_exa_api_key_here
# X API (fallback). XのBearer Tokenを設定すると直接取得を試します。
# LAB_ONBOARDER_X_API_BEARER_TOKEN=your_x_bearer_token_here
# LLMモデル（X APIデータからカード生成に使う）
# LAB_ONBOARDER_LLM_MODEL=gemini-3-flash-preview
# X API 캐시の有効期間（分）
# LAB_ONBOARDER_X_API_CACHE_TTL_MINUTES=360
# X APIフォールバックを使うか（0/false/noでOFF）
# LAB_ONBOARDER_X_API_ENABLED=0
# Gemini URL Context
# LAB_ONBOARDER_URL_CONTEXT_ENABLED=1
# LAB_ONBOARDER_URL_CONTEXT_MODEL=gemini-2.5-flash
# agi-lab と agi-lab-admin のロールIDをカンマ区切りで指定
LAB_ONBOARDER_ALLOWED_ROLE_IDS=ROLE_ID_1,ROLE_ID_2
# 管理者（デバッグコマンド）用ロールID
LAB_ONBOARDER_ADMIN_ROLE_IDS=ROLE_ID_ADMIN
# LAB_ONBOARDER_SQLITE_PATH=data/lab_onboarder/profiles.sqlite
# LAB_ONBOARDER_LOG_PATH=data/lab_onboarder/lab_onboarder.log
# LAB_ONBOARDER_LOG_CHANNEL_ID=123456789012345678
# テスト中だけDM送信を特定ユーザーに限定したい場合（空なら誰にも送らない）
# LAB_ONBOARDER_DM_ALLOWLIST_USER_IDS=YOUR_DISCORD_USER_ID
# またはユーザー名で限定
# LAB_ONBOARDER_DM_ALLOWLIST_USERNAMES=your_username
# デバッグログ
# LAB_ONBOARDER_DEBUG=1

# Membership Checker (note会員とDiscordの同期)
# レポート投稿先チャンネルID（必須）
MEMBERSHIP_CHECKER_LOG_CHANNEL_ID=123456789012345678
# note会員CSVのディレクトリ（任意・デフォルト: ~/Develop/note-extract-auto/data/output/active）
# MEMBERSHIP_CHECKER_CSV_DIR=/path/to/csv/dir
# レポート出力先ディレクトリ（任意・デフォルト: data/membership_checker）
# MEMBERSHIP_CHECKER_DATA_DIR=data/membership_checker
# ユーザー名マッチングを有効化（デフォルト: false）
# MEMBERSHIP_CHECKER_CONFIRM_USERNAMES=false
# デバッグログ
# MEMBERSHIP_CHECKER_DEBUG=1
